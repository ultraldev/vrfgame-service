NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/vrfgame_service
REDIS_URL=redis://localhost:6380
TRUSTED_ORIGINS=
BETTER_AUTH_URL=http://localhost:8000
BETTER_AUTH_SECRET=<openssl rand -base64 32>
KUCOIN_PAY_API_BASE_URL=https://pay.tunas.io/api/kucoinpay
KUCOIN_PAY_ONCHAIN_PAYIN_FEE_BPS=20
KUCOIN_PAY_PAYOUT_SERVICE_FEE=1
# KUCOIN_PAY_API_KEY=
# KUCOIN_PAY_PRIVATE_KEY=
# KUCOIN_PAY_PLATFORM_PUBLIC_KEY=
# KUCOIN_PAY_RELAY_AUTH_BASE64=
# KUCOIN_PAY_SUB_MERCHANT_ID=
ZEFFRA_API_BASE_URL=https://api.zeffra.com
# ZEFFRA_MERCHANT_CODE=
# ZEFFRA_PRIVATE_KEY=
# ZEFFRA_PUBLIC_KEY=
# ZEFFRA_WEBSITE=
# ZEFFRA_AUTH_RETURN_URL=
# ZEFFRA_NOTIFY_URL=
ZEFFRA_ENABLE_3DS=1
SEED_ENCRYPTION_ACTIVE_KEY_ID=2026-11
SEED_ENCRYPTION_KEYS={"2026-11":"<openssl rand -hex 32>"}
# BET_MIN_AMOUNT=0.01
# BET_MAX_AMOUNT=1000000
# PAYOUT_MAX_AMOUNT=100000
# Lifetime effective wagering required per unit withdrawn. 0 disables the gate.
WITHDRAW_WAGERING_RATIO=3
# Currency used to combine wagering and occupied withdrawals across pooled currencies.
# WITHDRAW_WAGERING_REPORTING_CURRENCY=USDT
# SEED_ADMIN_EMAIL=dev@example.com
# SEED_ADMIN_PASSWORD=Password@123
